<Window x:Class="AutomatePdm.GUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AutomatePdm.GUI"
        xmlns:designTime="clr-namespace:AutomatePdm.GUI.DesignTime"
        mc:Ignorable="d"
        d:DataContext="{x:Static designTime:DesignTimeFactory.MainViewModel}"
        Title="MainWindow" Height="450" Width="800">
    <Window.Resources>
        <Style TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style TargetType="Button" x:Key="IconButton">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="LightGray" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="DimGray"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <DataTemplate DataType="{x:Type local:TriggerViewModel}">
            <Border CornerRadius="2" 
                    x:Name="Bd"
                    BorderThickness="1"
                    Padding="2,0"
                    HorizontalAlignment="Stretch"
                    BorderBrush="Gray" Background="WhiteSmoke">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="{Binding Title}"
                               TextTrimming="CharacterEllipsis" 
                               FontSize="14"
                               Grid.ColumnSpan="2" Grid.Column="0" Grid.Row="0"
                               />

                    <TextBlock Text="on:"
                               FontSize="10"
                               Grid.Column="0" Grid.Row="1"
                               VerticalAlignment="Bottom"
                               />
                    <TextBlock Text="{Binding TriggerName}"  Margin="5,0"
                               Grid.Column="1" Grid.Row="1"
                               />
                    <Button Content="&#xE70F;"
                            Command="{Binding EditTriggerCommand}"
                            CommandParameter="{Binding}"
                            FontFamily="Segoe MDL2 Assets" FontSize="16"
                            Style="{StaticResource IconButton}"
                            Grid.Column="2" Grid.Row="0" Grid.RowSpan="2"
                            />

                    <Button Content="&#xECE7;"
                            FontFamily="Segoe MDL2 Assets" FontSize="16"
                            BorderThickness="0" 
                            Background="Transparent"
                            Foreground="LightGray"
                            Grid.Column="3" Grid.Row="0" Grid.RowSpan="2"
                            Cursor="ScrollNS"
                            />
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="SkyBlue" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <DataTemplate DataType="{x:Type local:ProcessStepViewModel}">
            <Border CornerRadius="2" 
                    BorderThickness="1"
                    Padding="2,0"
                    HorizontalAlignment="Stretch"
                    BorderBrush="Gray" Background="WhiteSmoke">
                <Border.ToolTip>
                    <StackPanel>
                        <TextBlock Text="{Binding Title}" FontSize="14"/>
                        <TextBlock Text="{Binding Description}"/>
                    </StackPanel>
                </Border.ToolTip>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="{Binding Title}"
                               TextTrimming="CharacterEllipsis" 
                               FontSize="14"
                               Grid.Column="0" Grid.Row="0"
                               />                    
                    <TextBlock Text="{Binding ProcessStepName}"  Margin="5,0"    
                               Grid.Column="0" Grid.Row="1"
                               />
                    <Button Content="&#xE70F;"
                            FontFamily="Segoe MDL2 Assets" FontSize="16"
                            BorderThickness="0" 
                            Background="Transparent"
                            Foreground="LightGray"
                            Grid.Column="1" Grid.Row="0" Grid.RowSpan="2"
                            />
                    <Button Content="&#xECE7;"
                            FontFamily="Segoe MDL2 Assets" FontSize="16"
                            BorderThickness="0" 
                            Background="Transparent"
                            Foreground="LightGray"
                            Grid.Column="2" Grid.Row="0" Grid.RowSpan="2"
                            />  
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <GroupBox Header="Trigger" Grid.Column="0">
            <ListBox SelectionMode="Single" ItemsSource="{Binding Triggers}"
                     SelectedItem="{Binding SelectedTrigger, Mode=TwoWay}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
               
            </ListBox>
        </GroupBox>


        <GroupBox Header="Script" Grid.Column="1">
            <ListBox SelectionMode="Single"
                     ItemsSource="{Binding SelectedTrigger.Script}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>

        </GroupBox>
        <local:PopupHost Grid.ColumnSpan="3" />
    </Grid>
</Window>
