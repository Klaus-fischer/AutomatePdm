<Window x:Class="AutomatePdm.GUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:core="clr-namespace:AutomatePdm;assembly=AutomatePdm"
        xmlns:local="clr-namespace:AutomatePdm.GUI"
        xmlns:designTime="clr-namespace:AutomatePdm.GUI.DesignTime"
        xmlns:dd="clr-namespace:AutomatePdm.GUI.DragDrop"
        xmlns:ani="clr-namespace:AutomatePdm.GUI.Animation"
        mc:Ignorable="d"
        local:MainWindow.IsSimulationMode="{Binding IsSimulationMode}"
        d:DataContext="{x:Static designTime:DesignTimeFactory.MainViewModel}"
        Title="MainWindow" Height="800" Width="1200">
    <Window.Resources>
        <Style TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border Margin="1">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" x:Key="IconButton">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="LightGray" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="DimGray"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <local:InvertConverter x:Key="InvertConverter"/>
        <local:BoolToKeyConverter x:Key="GridColumnsConverter" 
                                  TrueValue="0*, 3*, 6*, 0"
                                  FalseValue="2*, 3*, 0*, Auto"/>
    </Window.Resources>
    <ani:AnimatedGrid dd:DragDropManager.IsRoot="True"
                      x:Name="MainGrid"
                      d:Columns="2*, 3*, 3*, Auto"
                      Columns="{Binding IsSimulationMode, Converter={StaticResource GridColumnsConverter}}"
                      Rows="*, Auto">

        <GroupBox Header="Trigger" Grid.Column="0">
            <DockPanel>
                <Button DockPanel.Dock="Bottom" >
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="2"/>
                        <TextBlock Text="Hinzufügen" Margin="5,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <ListBox x:Name="TriggerListBox" 
                     ItemsSource="{Binding Triggers}"
                     SelectedItem="{Binding Triggers.SelectedItem, Mode=TwoWay}"
                     dd:DropTarget.AcceptType="{Binding Triggers.Type}"
                     dd:DropTarget.DropCommand="{Binding Triggers.DropCommand}"
                     dd:DropTarget.Key="Trigger"
                     SelectionMode="Single"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     >
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:TriggerViewModel}">
                            <Border CornerRadius="2" 
                                x:Name="Bd"
                                BorderThickness="1"
                                Padding="2,0"
                                HorizontalAlignment="Stretch"
                                BorderBrush="Gray" Background="WhiteSmoke"
                                dd:DropTarget.AcceptType="{Binding Script.Type}"
                                dd:DropTarget.DropCommand="{Binding Script.DropCommand}"
                                dd:DropTarget.Key="Script">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <dd:DragHandle Content = "&#xECE7;"
                                                   FontFamily = "Segoe MDL2 Assets"
                                                   Grid.Column="0" Grid.Row="0" Grid.RowSpan="2"
                                                   FontSize="16" Margin="0,0,5,0"
                                                   BorderThickness="0" Cursor="ScrollNS"
                                                   Background="Transparent"
                                                   Foreground="LightGray"
                                                   AllowedDropTargets="Trigger;Delete"
                                                   PreviewElement="{Binding ElementName=Bd}"
                                                   />
                                    <TextBlock Text="{Binding Title}"
                                               TextTrimming="CharacterEllipsis" 
                                               FontSize="14"
                                               Grid.Column="1" Grid.Row="0" Grid.ColumnSpan="2"
                                               />

                                    <TextBlock Text="on:"
                                               FontSize="10"
                                               Grid.Column="1" Grid.Row="1"
                                               VerticalAlignment="Bottom"
                                               />
                                    <TextBlock Text="{Binding TriggerName}"
                                               Margin="5,0"
                                               Grid.Column="2" Grid.Row="1"
                                               />
                                    <Button Content="&#xE70F;"
                                            Command="{Binding EditCommand}"
                                            CommandParameter="{Binding}"
                                            FontFamily="Segoe MDL2 Assets" FontSize="16"
                                            Style="{StaticResource IconButton}"
                                            Grid.Column="3" Grid.Row="0" Grid.RowSpan="2"
                                            />
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="SkyBlue" />
                                </DataTrigger>
                                <Trigger Property="dd:DragDropState.IsDraggingActive" Value="True">
                                    <Setter Property="Opacity" Value="0.5" />
                                </Trigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </GroupBox>

        <GroupBox Header="Script" Grid.Column="1">
            <ListBox SelectionMode="Single"
                     DataContext="{Binding Triggers.SelectedItem}"
                     ItemsSource="{Binding Script}"
                     dd:DropTarget.AcceptType="{Binding Script.Type}"
                     dd:DropTarget.DropCommand="{Binding Script.DropCommand}"
                     dd:DropTarget.Key="Script"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     >
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:PipelineStepViewModel}">
                        <Border x:Name="Bd"
                                CornerRadius="2" BorderThickness="1" Padding="2,0"
                                HorizontalAlignment="Stretch"
                                BorderBrush="Gray" Background="WhiteSmoke">
                            <Border.ToolTip>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontSize="14"/>
                                    <TextBlock Text="{Binding Description}"/>
                                </StackPanel>
                            </Border.ToolTip>
                            <Grid >
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="{Binding IconCode}"
                                           FontFamily="Segoe MDL2 Assets" 
                                           FontSize="20"
                                           VerticalAlignment="Center"
                                           Margin="5,0"
                                           Grid.Column="0" Grid.RowSpan="2"
                                           />
                                <TextBlock Text="{Binding Title}"
                                           TextTrimming="CharacterEllipsis" 
                                           FontSize="14"
                                           Grid.Column="1" Grid.Row="0"
                                           />
                                <TextBlock Text="{Binding ProcessStepName}"  Margin="5,0"    
                                           Grid.Column="1" Grid.Row="1"
                                           />

                                <dd:DragHandle x:Name="DragHandle"
                                               Content="&#xECE9;"
                                               FontFamily="Segoe MDL2 Assets"
                                               Grid.Column="2" Grid.Row="0" Grid.RowSpan="2"
                                               Margin="0,0,5,0"
                                               FontSize="16"
                                               BorderThickness="0"
                                               Background="Transparent"
                                               Foreground="LightGray"  
                                               AllowedDropTargets="Script;Trigger;Delete"
                                               Cursor="ScrollAll"
                                               PreviewElement="{Binding ElementName=Bd}"
                                               />

                                <Button x:Name="EditBtn"
                                        Content="&#xE70F;"
                                        FontFamily="Segoe MDL2 Assets" FontSize="16"
                                        Command="{Binding EditCommand}"
                                        CommandParameter="{Binding}"
                                        BorderThickness="0" 
                                        Background="Transparent"
                                        Foreground="LightGray"
                                        Grid.Column="3" Grid.Row="0" Grid.RowSpan="2"
                                        />
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="SkyBlue" />
                            </DataTrigger>
                            <Trigger Property="dd:DragDropState.IsDraggingActive" Value="True">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                            <Trigger Property="local:MainWindow.IsSimulationMode" Value="True">
                                <Setter TargetName="DragHandle" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="EditBtn" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

        </GroupBox>

        <DockPanel Grid.Column="3" LastChildFill="True">
            <DockPanel.Resources>
                <local:BoolToKeyConverter x:Key="ColorConverter">
                    <local:BoolToKeyConverter.TrueValue>
                        <SolidColorBrush Color="Crimson"/>
                    </local:BoolToKeyConverter.TrueValue>
                    <local:BoolToKeyConverter.FalseValue>
                        <SolidColorBrush Color="LightGray"/>
                    </local:BoolToKeyConverter.FalseValue>
                </local:BoolToKeyConverter>
            </DockPanel.Resources>

            <Border DockPanel.Dock="Bottom" 
                    BorderThickness="1"
                    Background="Transparent"
                    ToolTip="Elemente zum Löschen hier her ziehen."
                    BorderBrush="{Binding RelativeSource={RelativeSource Self}, Path=AllowDrop, Converter={StaticResource ColorConverter}}"
                    CornerRadius="2"
                    Margin="1"
                    dd:DropTarget.Key="Delete"
                    dd:DropTarget.DropCommand="{Binding DeleteCommand}"
                    dd:DropTarget.AllowCopy="False"
                    >
                <TextBlock HorizontalAlignment="Center"
                           Foreground="{Binding RelativeSource={RelativeSource Self}, Path=AllowDrop, Converter={StaticResource ColorConverter}}"
                           Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="32" 
                           Margin="2"
                           />
            </Border>
            <GroupBox Header="Templates" >
                <ListBox SelectionMode="Single"
                     ItemsSource="{Binding DragableProcessSteps}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     >
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:PipelineStepViewModel}">
                            <Border x:Name="Bd"
                                CornerRadius="2" BorderThickness="1" Padding="2,0"
                                HorizontalAlignment="Stretch"
                                BorderBrush="Gray" Background="WhiteSmoke">
                                <Border.ToolTip>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontSize="14"/>
                                        <TextBlock Text="{Binding Description}"/>
                                    </StackPanel>
                                </Border.ToolTip>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    
                                    <TextBlock Text="{Binding IconCode}"
                                           FontFamily="Segoe MDL2 Assets" 
                                           FontSize="20"
                                           VerticalAlignment="Center"
                                           Margin="5,0"
                                           Grid.Column="0" Grid.RowSpan="2"
                                           />

                                    <TextBlock Text="{Binding Title}"
                                           TextTrimming="CharacterEllipsis" 
                                           FontSize="14"
                                           Grid.Column="1" Grid.Row="0"
                                           />
                                    <TextBlock Text="{Binding ProcessStepName}"
                                           Margin="5,0"    
                                           Grid.Column="1" Grid.Row="1"
                                           />


                                    <dd:DragHandle Content = "&#xECE9;"
                                               FontFamily = "Segoe MDL2 Assets"
                                               Grid.Column="2" Grid.Row="0" Grid.RowSpan="2"
                                               FontSize="16" Margin="5,0,0,0"
                                               BorderThickness="0"
                                               Background="Transparent"
                                               Foreground="LightGray"  
                                               AllowedDropTargets="Script"
                                               Cursor="ScrollAll"
                                               AllowMove="False"
                                               PreviewElement="{Binding ElementName=Bd}"
                                               />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </GroupBox>
        </DockPanel>

        <DockPanel Grid.Row="1" Grid.ColumnSpan="4" LastChildFill="False">
            <ToggleButton Margin="5" Padding="10,5"
                          IsChecked="{Binding IsSimulationMode, Converter={StaticResource InvertConverter}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Editieren" VerticalAlignment="Center" />
                    <TextBlock Text="&#xE70F;" Margin="10,0,0,0"
                               FontFamily="Segoe MDL2 Assets" FontSize="20"
                               />
                </StackPanel>
            </ToggleButton>
            <ToggleButton Margin="5" Padding="10,5" 
                          IsChecked="{Binding IsSimulationMode}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Simulation" VerticalAlignment="Center" />
                    <TextBlock Text="&#xE768;" Margin="10,0,0,0"
                               FontFamily="Segoe MDL2 Assets" FontSize="20"
                               />
                    <TextBlock Text="&#xE769;" Margin="-9,0,0,0"
                               FontFamily="Segoe MDL2 Assets" FontSize="20"
                               />
                </StackPanel>
            </ToggleButton>
        </DockPanel>

        <local:PopupHost Grid.ColumnSpan="3" Grid.RowSpan="2"/>
    </ani:AnimatedGrid>
</Window>
