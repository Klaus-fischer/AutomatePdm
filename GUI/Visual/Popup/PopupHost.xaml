<UserControl x:Class="AutomatePdm.GUI.PopupHost"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AutomatePdm.GUI"
             xmlns:designTime="clr-namespace:AutomatePdm.GUI.DesignTime"
             mc:Ignorable="d" 
             d:DataContext="{x:Static designTime:DesignTimeFactory.MainViewModel}"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <DataTemplate DataType="{x:Type local:TriggerViewModel}">
            <local:TriggerPopup/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type local:ChangeStatePipelineStepViewModel}">
            <local:ChangeStatePipelineStepPopup/>
        </DataTemplate>
    </UserControl.Resources>
    <UserControl.Style>
        <Style TargetType="UserControl">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Popup}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <d:Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Style>
    <Grid >
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition MinHeight="50"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition MinHeight="50"/>
        </Grid.RowDefinitions>

        <Border Background="Black" Opacity="0.7" 
                IsHitTestVisible="True" 
                Grid.ColumnSpan="3" Grid.RowSpan="5"
                />

        <Border Background="LightGray" 
                BorderBrush="Black" CornerRadius="2" BorderThickness="1"
                Grid.Column="1" Grid.Row="1" Grid.RowSpan="3">

        </Border>

        <Border Background="White" Margin="3"
                Grid.Column="1" Grid.Row="2">
            <ContentPresenter x:Name="ContentHost" Content="{Binding Popup}"/>
        </Border>

        <TextBlock Text="{Binding PopupTitle}"
                   FontSize="14" VerticalAlignment="Center" Margin="5,5,30,5"
                   Grid.Column="1" Grid.Row="1"/>

        <Button Content="&#xF78A;"
                IsCancel="True" 
                Foreground="Crimson" Background="White"
                FontFamily="Segoe MDL2 Assets" FontSize="16"
                Margin="5,5" Padding="2"
                Grid.Column="1" Grid.Row="1"
                HorizontalAlignment="Right"
                Click="CancelClick"
                />

        <Button IsDefault="True" 
                Background="White"
                Margin="5,5" Padding="2"
                Grid.Column="1" Grid.Row="3"
                HorizontalAlignment="Right"
                Click="AcceptClick"
                >
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Übernehmen" Margin="10,0"/>
                <TextBlock Text="&#xF78C;"
                           Foreground="Green"
                           FontFamily="Segoe MDL2 Assets" 
                           FontSize="16"/>
            </StackPanel>
        </Button>
    </Grid>
</UserControl>
