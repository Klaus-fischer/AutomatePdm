<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <StartupObject>AutomatePdm.GUI.App</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Visual\Controls\ListBoxDragDropButton.cs" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="..\stylecop.json" Link="stylecop.json" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Visual\Controls\ListBoxDragDropButton.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AutomatePdm\AutomatePdm.csproj" />
  </ItemGroup>
  
  <ItemGroup>

    <PackageReference Include="StyleCop.Analyzers.Unstable" Version="1.2.0.556">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  
  <ItemGroup>
    <Reference Include="EPDM.Interop.epdm">
      <HintPath>..\Libraries\EPDM.Interop.epdm.dll</HintPath>
    </Reference>
  </ItemGroup>
  
  <ItemGroup>
    <Compile Update="Features\ProcessSteps\ChangeState\ChangeStatePipelineStepPopup.xaml.cs">
      <SubType>Code</SubType>
    </Compile>
    <Compile Update="Features\ProcessSteps\GetFileVariables\GetFileVariablesPipelineStepPopup.xaml.cs">
      <SubType>Code</SubType>
    </Compile>
  </ItemGroup>

</Project>
