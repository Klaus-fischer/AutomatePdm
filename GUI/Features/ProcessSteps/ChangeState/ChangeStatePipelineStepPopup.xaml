<UserControl x:Class="AutomatePdm.GUI.ChangeStatePipelineStepPopup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AutomatePdm.GUI"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=local:ChangeStatePipelineStepViewModel}"
             d:DesignWidth="400">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Visual/Resources/ApplicationResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel>
        <HeaderedContentControl Header="Titel">
            <TextBox x:Name="TitleTb" Text="{Binding Title, UpdateSourceTrigger=Explicit}"/>
        </HeaderedContentControl>
        <HeaderedContentControl Header="Beschreibung">
            <TextBox x:Name="DescriptionTb" 
                     Text="{Binding Description, UpdateSourceTrigger=Explicit}"
                     AcceptsReturn="True"
                     MinLines="3"/>
        </HeaderedContentControl>
        <HeaderedContentControl Header="Zielstatus">
            <ComboBox x:Name="TargetStateCb" ItemsSource="{Binding Source={StaticResource StatusReader}, Path=StatusNames}" 
                      SelectedValue="{Binding TargetStateName, UpdateSourceTrigger=Explicit}"
                      DisplayMemberPath="StatusName"
                      SelectedValuePath="StatusName"
                      />

        </HeaderedContentControl>
        <HeaderedContentControl Header="Kommentar" ToolTip="Dieser Kommentar wird später in der PDM-History sichtbar sein.">
            <TextBox x:Name="CommentTb" Text="{Binding Comment, UpdateSourceTrigger=Explicit}"/>
        </HeaderedContentControl>
    </StackPanel>
</UserControl>
